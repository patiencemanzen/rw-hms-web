# Base URL of the Rw-HMS API. Server-side only, read at build time: the browser calls /api/* on
# this app and Next.js proxies it there (keeps session cookies first-party).
API_URL=http://localhost:4000

# OpenAPI spec used by `npm run api:types` (the API must be running)
API_DOCS_URL=http://localhost:4000/api/docs-json

# Base URL Playwright opens for end-to-end tests
E2E_BASE_URL=http://localhost:3000
